[Unit]
Description=Prepare isolated LaIOT server
After=mariadb.service redis-server.service php8.3-fpm.service nginx.service
Requires=mariadb.service
Wants=redis-server.service php8.3-fpm.service nginx.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/laiot-server-prepare
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
