{
  "name": "majordomo-admin",
  "private": true,
  "version": "1.0.0",
  "description": "MajorDoMo admin panel asset build",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.mydomo.config.js && node tools/check-admin-assets.mjs",
    "build:mydomo": "vite build --config vite.mydomo.config.js && node tools/check-admin-assets.mjs",
    "watch": "vite build --config vite.mydomo.config.js --watch",
    "check": "node --check resources/js/app-mydomo.js",
    "icons": "node tools/generate-icon-catalog.mjs"
  },
  "dependencies": {
    "@tabler/icons-webfont": "^3.49.0",
    "alpinejs": "^3.17.4",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1"
  },
  "devDependencies": {
    "vite": "^8.0.0"
  }
}
