[Unit]
Description=LaIOT critical core worker %i
After=network.target mariadb.service mysql.service redis-server.service

[Service]
Type=simple
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@ROOT@@/current
ExecStart=/usr/bin/php @@ROOT@@/current/bin/laiot core-worker %i
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
MemoryMax=256M
Nice=-5
CPUWeight=500
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=@@ROOT@@/shared @@ROOT@@/current/var
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target
