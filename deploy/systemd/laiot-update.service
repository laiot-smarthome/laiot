[Unit]
Description=LaIOT release update and recovery
After=network.target mariadb.service mysql.service redis-server.service laiot-agent.service

[Service]
Type=oneshot
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@ROOT@@/current
ExecStart=/usr/bin/php @@ROOT@@/current/bin/laiot update:run
TimeoutStartSec=infinity
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
Environment=APP_ENV=production
