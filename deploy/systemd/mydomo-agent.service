[Unit]
Description=MyDoMo privileged systemd agent
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/php @@ROOT@@/current/bin/mydomo-agent serve
Restart=always
RestartSec=3
RuntimeDirectory=mydomo
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
