# ============================================================================
#  LaIOT configuration
# ============================================================================
#  Скопируйте файл в .env и заполните значения:
#      cp .env.example .env          (Linux)
#      copy .env.example .env        (Windows)
#
#  .env не коммитится и не должен попадать в веб-доступ.
#  Установка выполняется командами:
#      php bin/laiot db:migrate
#      php bin/laiot user:create admin "Администратор" "пароль" --admin
#  Отдельного веб-мастера в текущей ветке пока нет.
# ============================================================================

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Moscow

# ── База данных ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=laiot
DB_USER=laiot
DB_PASSWORD=

# ── Кэш и фоновое состояние ────────────────────────────────────────────────
# file, redis, database или array (отладка). Для production рекомендуется redis: worker-lock и
# heartbeat рассчитаны на общее хранилище.
CACHE_DRIVER=file

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Очередь ────────────────────────────────────────────────────────────────
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY=60
QUEUE_RESERVATION_TIMEOUT=300
QUEUE_HANDLER_TIMEOUT=5

# ── Журналы ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_MAX_FILES=14

# ── Хранение данных ────────────────────────────────────────────────────────
# 0 дней отключает очистку соответствующего раздела.
RETENTION_HISTORY_DAYS=90
RETENTION_EVENTS_DAYS=30
RETENTION_QUEUE_DAYS=14
RETENTION_TIMEOUTS_DAYS=7
RETENTION_ERRORS_DAYS=90
RETENTION_BATCH=5000
RETENTION_INTERVAL=21600
