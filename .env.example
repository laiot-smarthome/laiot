# ============================================================================
#  MyDoMo configuration
# ============================================================================
#  Скопируйте файл в .env и заполните значения:
#      cp .env.example .env          (Linux)
#      copy .env.example .env        (Windows)
#
#  .env не коммитится и не должен попадать в веб-доступ.
#  Установка выполняется командами:
#      php bin/mydomo db:migrate
#      php bin/mydomo user:create admin "Администратор" "пароль" --admin
#  Отдельного веб-мастера в текущей ветке пока нет.
# ============================================================================

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Moscow

# ── База данных ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mydomo
DB_USER=mydomo
DB_PASSWORD=

# ── Кэш и фоновое состояние ────────────────────────────────────────────────
# file или redis. Для production рекомендуется redis: worker-lock и
# heartbeat рассчитаны на общее хранилище.
CACHE_DRIVER=file

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
